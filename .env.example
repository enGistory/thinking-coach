# =========================
# Application
# =========================
APP_ENV=dev
APP_NAME=thinking-coach
APP_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173
TZ=America/New_York
LOG_LEVEL=INFO

# =========================
# Database
# =========================
DATABASE_URL=postgresql+asyncpg://thinking:thinking@postgres:5432/thinking
DATABASE_SYNC_URL=postgresql+psycopg://thinking:thinking@postgres:5432/thinking

# =========================
# Security - replace locally; never commit real values
# =========================
JWT_SECRET=replace-with-a-long-random-value
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30
LANGGRAPH_AES_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# =========================
# Audio
# =========================
AUDIO_ROOT=/data/audio
AUDIO_RETENTION_DAYS=30
MAX_AUDIO_SECONDS=180
MAX_AUDIO_MB=20

# =========================
# AI provider: all runtime models are online APIs
# =========================
AI_PROVIDER=aliyun
AI_PROVIDER_MODE=aliyun

# Aliyun Model Studio / DashScope
# Example Base URL for a workspace:
# https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=

# Qwen model routing - model IDs are configuration, never hard-coded
QWEN_DIALOG_MODEL=qwen3.6-plus
QWEN_QUESTION_MODEL=qwen3.5-plus
QWEN_REVIEW_MODEL=qwen3.6-plus
QWEN_VERIFY_MODEL=qwen3.6-plus
QWEN_FALLBACK_MODEL=qwen3.5-plus

# Online speech and embedding models
ALIYUN_ASR_MODEL=fun-asr
ALIYUN_TTS_MODEL=cosyvoice-v3.5-plus
ALIYUN_EMBEDDING_MODEL=text-embedding-v4

# LLM runtime policy
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_TEMPERATURE_DIALOG=0.2
LLM_TEMPERATURE_QUESTION=0.7
LLM_TEMPERATURE_REVIEW=0.0
QWEN_ENABLE_THINKING_DIALOG=false
QWEN_ENABLE_THINKING_QUESTION=true
QWEN_ENABLE_THINKING_REVIEW=true

# Optional: private OSS for ASR-accessible signed URLs
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_SIGNED_URL_TTL_SECONDS=900

# Search / source-grounding provider
SEARCH_PROVIDER=web_search
