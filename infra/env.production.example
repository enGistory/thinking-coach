POSTGRES_DB=thinking
POSTGRES_USER=thinking
POSTGRES_PASSWORD=change-me

APP_ENV=production
APP_BASE_URL=https://api.example.com
WEB_BASE_URL=https://app.example.com
TZ=Asia/Shanghai
JWT_SECRET=replace-with-strong-random-secret
LANGGRAPH_AES_KEY=replace-with-langgraph-aes-key

AUDIO_RETENTION_DAYS=30
MAX_AUDIO_SECONDS=180
MAX_AUDIO_MB=20
STRIKE_NOTIFICATION_TTL_MINUTES=5

AI_PROVIDER=aliyun
AI_PROVIDER_MODE=aliyun
DASHSCOPE_API_KEY=replace-with-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_HTTP_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_WEBSOCKET_BASE_URL=wss://dashscope.aliyuncs.com/api-ws/v1
QWEN_DIALOG_MODEL=replace-with-dialog-model
QWEN_QUESTION_MODEL=replace-with-question-model
QWEN_REVIEW_MODEL=replace-with-review-model
QWEN_VERIFY_MODEL=replace-with-verify-model
QWEN_FALLBACK_MODEL=replace-with-fallback-model
ALIYUN_ASR_MODEL=replace-with-asr-model
ALIYUN_TTS_MODEL=replace-with-tts-model
ALIYUN_TTS_VOICE=replace-with-tts-voice
ALIYUN_EMBEDDING_MODEL=replace-with-embedding-model
ALIYUN_EMBEDDING_DIMENSIONS=1024

SEARCH_PROVIDER=bocha
BOCHA_API_KEY=replace-with-bocha-key
BOCHA_SEARCH_ENDPOINT=https://api.bochaai.com/v1/web-search
BOCHA_SEARCH_COUNT=8
BOCHA_FRESHNESS=oneYear

WEB_PUSH_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
WEB_PUSH_VAPID_PRIVATE_KEY=replace-with-vapid-private-key
WEB_PUSH_ALLOW_FAKE_IP_HOSTS=

ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
ALIYUN_OSS_SIGNED_URL_TTL_SECONDS=900
